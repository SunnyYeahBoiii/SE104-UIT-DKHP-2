// Database schema for the course-registration and tuition system.
//
// Conventions:
// - Model and field names follow the CONTEXT.md glossary in English (ADR-0014); tables and columns are
//   snake_case via @@map / @map so raw SQL and TypedSQL queries (ADR-0009) read naturally.
// - Money is BigInt in whole VND (HP-08). Scores are DECIMAL(3,1) on the 10-point scale (KQ-02).
// - Integer ids keep a total order, which the registration transaction uses for lock ordering (ADR-0005).
// - Invariants Prisma cannot express (CHECK constraints, expression indexes) are hand-written in the
//   migration SQL; see prisma/migrations/*/migration.sql.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["typedSql", "partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Accounts ─────────────────────────────

enum Role {
  STUDENT
  LECTURER
  ACADEMIC_OFFICE
  FINANCE_OFFICE
  ADMIN
}

/// A login. Sessions live in Redis (ADR-0013), so there is no session table.
model User {
  id                 Int       @id @default(autoincrement())
  username           String    @unique
  /// argon2id hash (NFR-08).
  passwordHash       String    @map("password_hash")
  fullName           String    @map("full_name")
  email              String?   @unique
  /// One account may hold several roles, e.g. a lecturer who also works in the academic office.
  roles              Role[]
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  isActive           Boolean   @default(true) @map("is_active")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  student  Student?
  lecturer Lecturer?

  notifications Notification[]
  auditLogs     AuditLog[]

  statusDecisions      StudentStatusDecision[]
  leaveDecisions       LeaveDecision[]
  submittedGradebooks  Gradebook[]             @relation("GradebookSubmittedBy")
  lockedGradebooks     Gradebook[]             @relation("GradebookLockedBy")
  gradeAmendments      GradeAmendment[]
  liftedExamBans       ExamBan[]
  ledgerEntries        LedgerEntry[]
  adjustments          Adjustment[]
  collectedReceipts    Receipt[]
  assignedTransactions BankTransaction[]
  systemParameters     SystemParameter[]

  @@map("user_account")
}

// ─────────────────────────── Organisation ───────────────────────────

model Province {
  id        Int        @id @default(autoincrement())
  code      String     @unique
  name      String
  districts District[]

  @@map("province")
}

/// HS-01: a hometown is a district of a province; each district carries a remote-area flag.
model District {
  id         Int       @id @default(autoincrement())
  provinceId Int       @map("province_id")
  code       String    @unique
  name       String
  isRemote   Boolean   @default(false) @map("is_remote")
  province   Province  @relation(fields: [provinceId], references: [id])
  students   Student[]

  @@index([provinceId])
  @@map("district")
}

model Faculty {
  id        Int        @id @default(autoincrement())
  code      String     @unique
  name      String
  majors    Major[]
  lecturers Lecturer[]
  courses   Course[]

  @@map("faculty")
}

model Major {
  id        Int          @id @default(autoincrement())
  facultyId Int          @map("faculty_id")
  code      String       @unique
  name      String
  faculty   Faculty      @relation(fields: [facultyId], references: [id])
  students  Student[]
  curricula Curriculum[]

  @@index([facultyId])
  @@map("major")
}

/// Admission cohort, e.g. K18 = students admitted in 2023. A student's cohort never changes (HS-04).
model Cohort {
  id            Int    @id @default(autoincrement())
  code          String @unique
  admissionYear Int    @unique @map("admission_year")

  students          Student[]
  curricula         Curriculum[]
  feeSchedule       FeeSchedule?
  registrationSlots RegistrationSlotCohort[]

  @@map("cohort")
}

/// HS-02: discount rate in percent; when a student is in several groups only the highest `priority` applies.
model PriorityGroup {
  id           Int                    @id @default(autoincrement())
  code         String                 @unique
  name         String
  discountRate Int                    @map("discount_rate")
  priority     Int
  students     StudentPriorityGroup[]

  @@map("priority_group")
}

enum Gender {
  MALE
  FEMALE
}

/// Student profile from BM1. Only the academic office edits it (QV-01).
model Student {
  id                 Int      @id @default(autoincrement())
  studentCode        String   @unique @map("student_code")
  userId             Int      @unique @map("user_id")
  fullName           String   @map("full_name")
  dateOfBirth        DateTime @map("date_of_birth") @db.Date
  gender             Gender
  hometownDistrictId Int      @map("hometown_district_id")
  majorId            Int      @map("major_id")
  cohortId           Int      @map("cohort_id")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user             User     @relation(fields: [userId], references: [id])
  hometownDistrict District @relation(fields: [hometownDistrictId], references: [id])
  major            Major    @relation(fields: [majorId], references: [id])
  cohort           Cohort   @relation(fields: [cohortId], references: [id])

  priorityGroups    StudentPriorityGroup[]
  statusDecisions   StudentStatusDecision[]
  leaveDecisions    LeaveDecision[]
  registrationForms RegistrationForm[]
  examBans          ExamBan[]
  ledgerEntries     LedgerEntry[]
  adjustments       Adjustment[]
  receipts          Receipt[]
  bankTransactions  BankTransaction[]

  @@index([cohortId, majorId])
  @@map("student")
}

model StudentPriorityGroup {
  studentId       Int           @map("student_id")
  priorityGroupId Int           @map("priority_group_id")
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  priorityGroup   PriorityGroup @relation(fields: [priorityGroupId], references: [id])

  @@id([studentId, priorityGroupId])
  @@map("student_priority_group")
}

enum StudentStatus {
  ACTIVE
  ON_LEAVE
  WITHDRAWN
  GRADUATED
}

/// HS-06: status only changes through an academic-office decision. The status in a term is the latest
/// decision whose effective term is not after it, overridden by a LeaveDecision for that term.
model StudentStatusDecision {
  id              Int           @id @default(autoincrement())
  studentId       Int           @map("student_id")
  status          StudentStatus
  effectiveTermId Int           @map("effective_term_id")
  reason          String
  decidedById     Int?          @map("decided_by_id")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  student       Student @relation(fields: [studentId], references: [id])
  effectiveTerm Term    @relation(fields: [effectiveTermId], references: [id])
  decidedBy     User?   @relation(fields: [decidedById], references: [id])

  @@index([studentId, createdAt])
  @@map("student_status_decision")
}

/// Leave of absence for one term. A multi-term leave is one row per term.
model LeaveDecision {
  id          Int      @id @default(autoincrement())
  studentId   Int      @map("student_id")
  termId      Int      @map("term_id")
  reason      String
  decidedById Int?     @map("decided_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  student   Student @relation(fields: [studentId], references: [id])
  term      Term    @relation(fields: [termId], references: [id])
  decidedBy User?   @relation(fields: [decidedById], references: [id])

  @@unique([studentId, termId])
  @@map("leave_decision")
}

model Lecturer {
  id           Int             @id @default(autoincrement())
  lecturerCode String          @unique @map("lecturer_code")
  userId       Int             @unique @map("user_id")
  fullName     String          @map("full_name")
  facultyId    Int             @map("faculty_id")
  user         User            @relation(fields: [userId], references: [id])
  faculty      Faculty         @relation(fields: [facultyId], references: [id])
  sections     CourseSection[]

  @@map("lecturer")
}

// ────────────────────────── Courses & curriculum ──────────────────────────

enum CourseType {
  THEORY
  PRACTICE
}

/// DT-01/DT-02: one type per course; credits = totalPeriods / 15 (THEORY) or / 30 (PRACTICE).
/// A course with both parts is two courses (ADR-0002): every PRACTICE course points at exactly one companion
/// THEORY course (CHECK), and a THEORY course has at most one PRACTICE course (unique). The PRACTICE code is
/// the THEORY code plus `TH`, e.g. IT004 / IT004TH.
model Course {
  id                      Int        @id @default(autoincrement())
  code                    String     @unique
  name                    String
  type                    CourseType
  totalPeriods            Int        @map("total_periods")
  credits                 Int
  facultyId               Int?       @map("faculty_id")
  companionTheoryCourseId Int?       @unique @map("companion_theory_course_id")
  equivalenceId           Int?       @map("equivalence_id")
  createdAt               DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  faculty               Faculty?           @relation(fields: [facultyId], references: [id])
  companionTheoryCourse Course?            @relation("CompanionTheory", fields: [companionTheoryCourseId], references: [id])
  practiceCourse        Course?            @relation("CompanionTheory")
  equivalence           CourseEquivalence? @relation(fields: [equivalenceId], references: [id])

  prerequisites     Prerequisite[]     @relation("PrerequisiteOf")
  requiredBy        Prerequisite[]     @relation("PrerequisiteFor")
  curriculumCourses CurriculumCourse[]
  offerings         OfferedCourse[]
  enrollments       Enrollment[]

  @@index([equivalenceId])
  @@map("course")
}

/// DT-04: courses in one group count as a single course for attempt type, prerequisites and credits.
model CourseEquivalence {
  id      Int      @id @default(autoincrement())
  name    String
  courses Course[]

  @@map("course_equivalence")
}

enum PrerequisiteType {
  /// The prerequisite course must be passed.
  REQUIRED_PASS
  /// The prerequisite course must have been taken and graded, pass or fail.
  REQUIRED_ATTEMPT
}

/// DT-05: the graph must be acyclic; the application checks that on insert.
model Prerequisite {
  courseId             Int              @map("course_id")
  prerequisiteCourseId Int              @map("prerequisite_course_id")
  type                 PrerequisiteType
  course               Course           @relation("PrerequisiteOf", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisiteCourse   Course           @relation("PrerequisiteFor", fields: [prerequisiteCourseId], references: [id])

  @@id([courseId, prerequisiteCourseId])
  @@index([prerequisiteCourseId])
  @@map("prerequisite")
}

/// BM3 / DT-03: the study plan of one (major, cohort).
model Curriculum {
  id              Int              @id @default(autoincrement())
  majorId         Int              @map("major_id")
  cohortId        Int              @map("cohort_id")
  minTotalCredits Int              @map("min_total_credits")
  major           Major            @relation(fields: [majorId], references: [id])
  cohort          Cohort           @relation(fields: [cohortId], references: [id])
  knowledgeBlocks KnowledgeBlock[]

  @@unique([majorId, cohortId])
  @@map("curriculum")
}

enum KnowledgeBlockType {
  /// Every course in the block must be passed.
  REQUIRED
  /// At least `minCredits` must be passed from the block's courses.
  ELECTIVE
}

model KnowledgeBlock {
  id           Int                @id @default(autoincrement())
  curriculumId Int                @map("curriculum_id")
  name         String
  type         KnowledgeBlockType
  /// Required for ELECTIVE blocks; null for REQUIRED blocks.
  minCredits   Int?               @map("min_credits")
  sortOrder    Int                @default(0) @map("sort_order")
  curriculum   Curriculum         @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  courses      CurriculumCourse[]

  @@index([curriculumId])
  @@map("knowledge_block")
}

model CurriculumCourse {
  knowledgeBlockId Int            @map("knowledge_block_id")
  courseId         Int            @map("course_id")
  /// 1-based term within the programme. Advisory only (DT-07).
  suggestedTerm    Int            @map("suggested_term")
  knowledgeBlock   KnowledgeBlock @relation(fields: [knowledgeBlockId], references: [id], onDelete: Cascade)
  course           Course         @relation(fields: [courseId], references: [id])

  @@id([knowledgeBlockId, courseId])
  @@index([courseId])
  @@map("curriculum_course")
}

// ─────────────────────────── Terms & sections ───────────────────────────

model AcademicYear {
  id        Int    @id @default(autoincrement())
  /// 2025 for the 2025-2026 academic year.
  startYear Int    @unique @map("start_year")
  terms     Term[]

  @@map("academic_year")
}

enum TermType {
  FIRST
  SECOND
  SUMMER
}

/// HK-03: phases move forward only, driven by the milestone timestamps.
enum TermPhase {
  PREPARATION
  REGISTRATION
  ADJUSTMENT
  IN_PROGRESS
  CLOSED
}

/// HK-02 milestone order is enforced by a CHECK constraint; HK-04 (one term open for registration at a
/// time) by a unique expression index. Credit limits are copied from system parameters when the term is
/// created so later parameter changes are not retroactive.
model Term {
  id                  Int       @id @default(autoincrement())
  academicYearId      Int       @map("academic_year_id")
  type                TermType
  /// HK-01: start year of the academic year + 1/2/3, e.g. "20251".
  termCode            String    @unique @map("term_code")
  phase               TermPhase @default(PREPARATION)
  /// Monday of week 1; Meeting.weeks counts from here.
  startDate           DateTime  @map("start_date") @db.Date
  registrationStartAt DateTime  @map("registration_start_at") @db.Timestamptz(3)
  registrationEndAt   DateTime  @map("registration_end_at") @db.Timestamptz(3)
  adjustmentStartAt   DateTime  @map("adjustment_start_at") @db.Timestamptz(3)
  adjustmentEndAt     DateTime  @map("adjustment_end_at") @db.Timestamptz(3)
  tuitionDeadline     DateTime  @map("tuition_deadline") @db.Timestamptz(3)
  finalExamStartAt    DateTime  @map("final_exam_start_at") @db.Timestamptz(3)
  minCredits          Int       @map("min_credits")
  maxCredits          Int       @map("max_credits")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  registrationSlots RegistrationSlot[]
  offeredCourses    OfferedCourse[]
  registrationForms RegistrationForm[]
  statusDecisions   StudentStatusDecision[]
  leaveDecisions    LeaveDecision[]
  examBans          ExamBan[]
  ledgerEntries     LedgerEntry[]
  adjustments       Adjustment[]
  receipts          Receipt[]
  bankTransactions  BankTransaction[]

  @@unique([academicYearId, type])
  @@map("term")
}

/// HK-05: a window inside the REGISTRATION phase reserved for a set of cohorts.
model RegistrationSlot {
  id      Int                      @id @default(autoincrement())
  termId  Int                      @map("term_id")
  name    String
  startAt DateTime                 @map("start_at") @db.Timestamptz(3)
  endAt   DateTime                 @map("end_at") @db.Timestamptz(3)
  term    Term                     @relation(fields: [termId], references: [id], onDelete: Cascade)
  cohorts RegistrationSlotCohort[]

  @@index([termId])
  @@map("registration_slot")
}

model RegistrationSlotCohort {
  registrationSlotId Int              @map("registration_slot_id")
  cohortId           Int              @map("cohort_id")
  registrationSlot   RegistrationSlot @relation(fields: [registrationSlotId], references: [id], onDelete: Cascade)
  cohort             Cohort           @relation(fields: [cohortId], references: [id])

  @@id([registrationSlotId, cohortId])
  @@map("registration_slot_cohort")
}

/// BM4: a course opened in a term.
model OfferedCourse {
  id       Int             @id @default(autoincrement())
  termId   Int             @map("term_id")
  courseId Int             @map("course_id")
  term     Term            @relation(fields: [termId], references: [id])
  course   Course          @relation(fields: [courseId], references: [id])
  sections CourseSection[]

  @@unique([termId, courseId])
  @@map("offered_course")
}

/// DT-11: set on a THEORY section that has practice sections and shared by all of them; frozen once the term
/// leaves PREPARATION. SCHEDULED (HT1): one or two sections with fixed meetings. SELF_SCHEDULED (HT2): exactly
/// one section with no meetings and the same capacity as the THEORY section.
enum PracticeMode {
  SCHEDULED
  SELF_SCHEDULED
}

/// The unit students register for, e.g. SE104.P21. A PracticeSection (SE104.P21.1) belongs to a PRACTICE
/// course offering and points at its parent section of the companion THEORY course (ADR-0002); a parent has
/// at most two, coded `.1` and `.2`. Only the parent carries `practiceMode`.
/// `enrolledCount` is only changed by the conditional UPDATE in ADR-0005 and guarded by a CHECK.
model CourseSection {
  id              Int           @id @default(autoincrement())
  offeredCourseId Int           @map("offered_course_id")
  code            String
  lecturerId      Int?          @map("lecturer_id")
  capacity        Int
  enrolledCount   Int           @default(0) @map("enrolled_count")
  parentSectionId Int?          @map("parent_section_id")
  practiceMode    PracticeMode? @map("practice_mode")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  offeredCourse    OfferedCourse   @relation(fields: [offeredCourseId], references: [id])
  lecturer         Lecturer?       @relation(fields: [lecturerId], references: [id])
  parentSection    CourseSection?  @relation("PracticeSections", fields: [parentSectionId], references: [id])
  practiceSections CourseSection[] @relation("PracticeSections")

  meetings    Meeting[]
  enrollments Enrollment[]
  gradebook   Gradebook?

  @@unique([offeredCourseId, code])
  @@index([parentSectionId])
  @@index([lecturerId])
  @@map("course_section")
}

/// DT-09: a recurring class meeting. `weeks` is a bitmask where bit 0 is week 1 of the term.
model Meeting {
  id        Int           @id @default(autoincrement())
  sectionId Int           @map("section_id")
  /// 2 = Monday … 8 = Sunday, the Vietnamese "Thứ" numbering.
  dayOfWeek Int           @map("day_of_week")
  startSlot Int           @map("start_slot")
  endSlot   Int           @map("end_slot")
  room      String
  weeks     Int
  section   CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@map("meeting")
}

// ────────────────────────── Registration & grades ──────────────────────────

/// BM5 / DK-01: at most one form per (student, term). Its row is the per-student lock in ADR-0005.
model RegistrationForm {
  id          Int          @id @default(autoincrement())
  studentId   Int          @map("student_id")
  termId      Int          @map("term_id")
  finalizedAt DateTime?    @map("finalized_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  student     Student      @relation(fields: [studentId], references: [id])
  term        Term         @relation(fields: [termId], references: [id])
  enrollments Enrollment[]

  @@unique([studentId, termId])
  @@index([termId])
  @@map("registration_form")
}

enum EnrollmentStatus {
  REGISTERED
  CANCELLED
  FINALIZED
}

enum AttemptType {
  FIRST
  RETAKE
  IMPROVEMENT
  FREE_ELECTIVE
}

/// One seat in one section. `courseId` duplicates section → offered course → course so the partial unique
/// index can enforce DK-04 for the same course; equivalent courses are checked by the application.
/// `credits`, `creditRate` and `surcharge` are frozen at registration time (HP-04).
model Enrollment {
  id                  Int              @id @default(autoincrement())
  formId              Int              @map("form_id")
  sectionId           Int              @map("section_id")
  courseId            Int              @map("course_id")
  status              EnrollmentStatus @default(REGISTERED)
  attemptType         AttemptType      @map("attempt_type")
  pendingPrerequisite Boolean          @default(false) @map("pending_prerequisite")
  credits             Int
  creditRate          BigInt           @map("credit_rate")
  /// credits × creditRate when HP-03 applies, else 0.
  surcharge           BigInt           @default(0)
  /// Weighted course score, written when the gradebook is locked (KQ-02).
  courseScore         Decimal?         @map("course_score") @db.Decimal(3, 1)
  registeredAt        DateTime         @default(now()) @map("registered_at") @db.Timestamptz(3)
  cancelledAt         DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  finalizedAt         DateTime?        @map("finalized_at") @db.Timestamptz(3)

  form    RegistrationForm @relation(fields: [formId], references: [id])
  section CourseSection    @relation(fields: [sectionId], references: [id])
  course  Course           @relation(fields: [courseId], references: [id])

  componentScores ComponentScore[]
  gradeAmendments GradeAmendment[]
  ledgerEntries   LedgerEntry[]

  @@unique([formId, courseId], map: "enrollment_active_course_key", where: raw("status <> 'CANCELLED'"))
  @@index([formId])
  @@index([sectionId])
  @@index([courseId])
  @@map("enrollment")
}

enum GradebookStatus {
  DRAFT
  SUBMITTED
  LOCKED
}

/// KQ-05: DRAFT → SUBMITTED (lecturer) → LOCKED (academic office).
model Gradebook {
  id            Int             @id @default(autoincrement())
  sectionId     Int             @unique @map("section_id")
  status        GradebookStatus @default(DRAFT)
  submittedAt   DateTime?       @map("submitted_at") @db.Timestamptz(3)
  submittedById Int?            @map("submitted_by_id")
  lockedAt      DateTime?       @map("locked_at") @db.Timestamptz(3)
  lockedById    Int?            @map("locked_by_id")

  section     CourseSection    @relation(fields: [sectionId], references: [id])
  submittedBy User?            @relation("GradebookSubmittedBy", fields: [submittedById], references: [id])
  lockedBy    User?            @relation("GradebookLockedBy", fields: [lockedById], references: [id])
  components  GradeComponent[]

  @@map("gradebook")
}

/// KQ-01: weights (percent) of a gradebook sum to 100 and exactly one component is the final exam.
model GradeComponent {
  id          Int       @id @default(autoincrement())
  gradebookId Int       @map("gradebook_id")
  name        String
  weight      Int
  isFinal     Boolean   @default(false) @map("is_final")
  sortOrder   Int       @default(0) @map("sort_order")
  gradebook   Gradebook @relation(fields: [gradebookId], references: [id], onDelete: Cascade)

  scores     ComponentScore[]
  amendments GradeAmendment[]

  @@unique([gradebookId, name])
  @@unique([gradebookId], map: "grade_component_one_final_key", where: raw("is_final"))
  @@map("grade_component")
}

model ComponentScore {
  enrollmentId Int            @map("enrollment_id")
  componentId  Int            @map("component_id")
  score        Decimal        @db.Decimal(3, 1)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  enrollment   Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  component    GradeComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@id([enrollmentId, componentId])
  @@index([componentId])
  @@map("component_score")
}

/// KQ-06: every score change after LOCKED, with its reason. Append-only.
model GradeAmendment {
  id           Int            @id @default(autoincrement())
  enrollmentId Int            @map("enrollment_id")
  componentId  Int            @map("component_id")
  oldScore     Decimal        @map("old_score") @db.Decimal(3, 1)
  newScore     Decimal        @map("new_score") @db.Decimal(3, 1)
  reason       String
  amendedById  Int            @map("amended_by_id")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  enrollment   Enrollment     @relation(fields: [enrollmentId], references: [id])
  component    GradeComponent @relation(fields: [componentId], references: [id])
  amendedBy    User           @relation(fields: [amendedById], references: [id])

  @@index([enrollmentId])
  @@map("grade_amendment")
}

/// CT-01..CT-04: a ban covers every section of the term. Lifting requires a reason.
model ExamBan {
  id                Int       @id @default(autoincrement())
  studentId         Int       @map("student_id")
  termId            Int       @map("term_id")
  /// Outstanding amount at the time the ban job ran, for the record.
  outstandingAmount BigInt    @map("outstanding_amount")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  liftedAt          DateTime? @map("lifted_at") @db.Timestamptz(3)
  liftedById        Int?      @map("lifted_by_id")
  liftReason        String?   @map("lift_reason")
  student           Student   @relation(fields: [studentId], references: [id])
  term              Term      @relation(fields: [termId], references: [id])
  liftedBy          User?     @relation(fields: [liftedById], references: [id])

  @@unique([studentId, termId])
  @@map("exam_ban")
}

// ────────────────────────────── Tuition ──────────────────────────────

/// HP-01: one fee schedule per cohort. Rates are copied onto enrollments, so edits are not retroactive.
model FeeSchedule {
  id                 Int      @id @default(autoincrement())
  cohortId           Int      @unique @map("cohort_id")
  baseTuition        BigInt   @map("base_tuition")
  theoryCreditRate   BigInt   @default(27000) @map("theory_credit_rate")
  practiceCreditRate BigInt   @default(37000) @map("practice_credit_rate")
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  cohort             Cohort   @relation(fields: [cohortId], references: [id])

  @@map("fee_schedule")
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerEntryType {
  BASE_TUITION
  SURCHARGE
  SURCHARGE_REVERSAL
  DISCOUNT
  DISCOUNT_REVERSAL
  PAYMENT
  ADJUSTMENT
  REFUND
  BALANCE_CARRY_OUT
  BALANCE_CARRY_IN
}

/// ADR-0004: append-only. No UPDATE, no DELETE; corrections are reversal or adjustment entries.
/// Amounts are always positive; `direction` gives the sign. BM7 figures are sums over these rows.
model LedgerEntry {
  id             Int             @id @default(autoincrement())
  studentId      Int             @map("student_id")
  termId         Int             @map("term_id")
  type           LedgerEntryType
  direction      LedgerDirection
  amount         BigInt
  /// For DISCOUNT rows: the rate frozen when the matching debit was posted (HP-06).
  discountRate   Int?            @map("discount_rate")
  description    String?
  enrollmentId   Int?            @map("enrollment_id")
  receiptId      Int?            @map("receipt_id")
  adjustmentId   Int?            @map("adjustment_id")
  /// The entry this one reverses or discounts, e.g. a DISCOUNT points at its BASE_TUITION debit.
  relatedEntryId Int?            @map("related_entry_id")
  /// Null when the system posted the entry.
  createdById    Int?            @map("created_by_id")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  student      Student       @relation(fields: [studentId], references: [id])
  term         Term          @relation(fields: [termId], references: [id])
  enrollment   Enrollment?   @relation(fields: [enrollmentId], references: [id])
  receipt      Receipt?      @relation(fields: [receiptId], references: [id])
  adjustment   Adjustment?   @relation(fields: [adjustmentId], references: [id])
  relatedEntry LedgerEntry?  @relation("RelatedEntry", fields: [relatedEntryId], references: [id])
  relatedFrom  LedgerEntry[] @relation("RelatedEntry")
  createdBy    User?         @relation(fields: [createdById], references: [id])

  @@index([studentId, termId])
  @@index([termId])
  @@index([enrollmentId])
  @@index([relatedEntryId])
  @@map("ledger_entry")
}

/// A correction to a student's ledger for a term, always with a reason (HP-07, HS-07).
model Adjustment {
  id            Int           @id @default(autoincrement())
  studentId     Int           @map("student_id")
  termId        Int           @map("term_id")
  reason        String
  createdById   Int?          @map("created_by_id")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  student       Student       @relation(fields: [studentId], references: [id])
  term          Term          @relation(fields: [termId], references: [id])
  createdBy     User?         @relation(fields: [createdById], references: [id])
  ledgerEntries LedgerEntry[]

  @@index([studentId, termId])
  @@map("adjustment")
}

// ────────────────────────────── Payments ──────────────────────────────

enum PaymentChannel {
  COUNTER
  BANK_TRANSFER
}

/// BM6: one receipt per payment, whatever the channel (TT-01, TT-09). The unique bankTransactionId
/// guarantees one SePay transaction yields at most one receipt (TT-05).
model Receipt {
  id                Int            @id @default(autoincrement())
  receiptNumber     String         @unique @map("receipt_number")
  studentId         Int            @map("student_id")
  termId            Int            @map("term_id")
  channel           PaymentChannel
  amount            BigInt
  /// Bank transaction time for transfers (CT-01), cash time for counter payments.
  paidAt            DateTime       @map("paid_at") @db.Timestamptz(3)
  bankTransactionId Int?           @unique @map("bank_transaction_id")
  collectedById     Int?           @map("collected_by_id")
  note              String?
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  student         Student          @relation(fields: [studentId], references: [id])
  term            Term             @relation(fields: [termId], references: [id])
  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id])
  collectedBy     User?            @relation(fields: [collectedById], references: [id])
  ledgerEntries   LedgerEntry[]

  @@index([studentId, termId])
  @@map("receipt")
}

enum BankTransactionStatus {
  /// Stored by the webhook, waiting for the worker.
  PENDING
  MATCHED
  /// No student/term matched the payment code; waits in the finance office's manual queue (TT-07).
  UNMATCHED
  /// Not a tuition payment, dismissed by the finance office.
  IGNORED
}

/// A SePay incoming transfer (ADR-0011). `sepayId` is unique so repeated webhooks are no-ops.
model BankTransaction {
  id               Int                   @id @default(autoincrement())
  sepayId          BigInt                @unique @map("sepay_id")
  gateway          String
  accountNumber    String                @map("account_number")
  /// Bank-side time; exam bans are decided on this, not on webhook arrival (CT-01).
  transactionDate  DateTime              @map("transaction_date") @db.Timestamptz(3)
  /// Payment code SePay extracted from the transfer content, e.g. HP2352000120251.
  code             String?
  content          String
  referenceCode    String?               @map("reference_code")
  amount           BigInt
  status           BankTransactionStatus @default(PENDING)
  matchedStudentId Int?                  @map("matched_student_id")
  matchedTermId    Int?                  @map("matched_term_id")
  assignedById     Int?                  @map("assigned_by_id")
  rawPayload       Json                  @map("raw_payload")
  receivedAt       DateTime              @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt      DateTime?             @map("processed_at") @db.Timestamptz(3)

  matchedStudent Student? @relation(fields: [matchedStudentId], references: [id])
  matchedTerm    Term?    @relation(fields: [matchedTermId], references: [id])
  assignedBy     User?    @relation(fields: [assignedById], references: [id])
  receipt        Receipt?

  @@index([status])
  @@index([code])
  @@map("bank_transaction")
}

// ─────────────────────────── Infrastructure ───────────────────────────

/// ADR-0008: events written in the same transaction as the change; a relay pushes them to BullMQ.
model OutboxEvent {
  id          Int       @id @default(autoincrement())
  type        String
  payload     Json
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  @@index([createdAt], map: "outbox_unpublished_idx", where: raw("published_at IS NULL"))
  @@map("outbox")
}

/// NFR-11: in-app notifications.
model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notification")
}

/// NFR-10: append-only audit trail written by the command interceptor (ADR-0008).
model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?     @map("actor_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  payload    Json?
  requestId  String?  @map("request_id")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_log")
}

/// Tunable defaults from requirements §10, edited by admin or finance. Values are JSON so one table holds
/// numbers, money and durations alike.
model SystemParameter {
  key         String   @id
  value       Json
  description String?
  updatedById Int?     @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy   User?    @relation(fields: [updatedById], references: [id])

  @@map("system_parameter")
}
